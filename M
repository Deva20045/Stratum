function render(){
  const root = document.getElementById('root');
  if(app.screen==='loading'){ root.innerHTML = '<div class="empty-note">Loading…</div>'; return; }
  if(app.screen==='dashboard') return renderDashboard(root);
  if(app.screen==='chapterList') return renderChapterList(root);
  if(app.screen==='chapterMap') return renderChapterMap(root);
  if(app.screen==='unit') return renderUnitIntro(root);
  if(app.screen==='quiz') return renderQuiz(root);
  if(app.screen==='results') return renderResults(root);
  if(app.screen==='review-empty') return renderReviewEmpty(root);
}

