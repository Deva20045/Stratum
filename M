function startQuiz(unitId){
  const ch = chapterById(app.chapterId);
  const u = unitById(ch, unitId);
  app.unitId = unitId;
  app.reviewQueue = [];
  app.order = shuffle(u.questions.map((_,i)=>i));
  app.qIndex = 0; app.answered = null; app.correctCount = 0; app.xpGained = 0;
  app.screen = 'quiz';
  render();
}
function startReview(){
  const pool = [];
  CHAPTERS.forEach(ch=>{
    if(!ch.built) return;
    ch.units.forEach(u=>{
      u.questions.forEach((q, i)=>{
        const key = qKey(ch.id, u.id, i);
        if(state.mistakes.includes(key)) pool.push({chapterId:ch.id, unitId:u.id, qIndex:i, q});
      });
    });
  });
  if(pool.length===0){ app.screen='review-empty'; render(); return; }
  app.chapterId = null; app.unitId = 'review';
  app.reviewQueue = shuffle(pool);
  app.order = app.reviewQueue.map((_,i)=>i);
  app.qIndex = 0; app.answered=null; app.correctCount=0; app.xpGained=0;
  app.screen='quiz';
  render();
}
function currentQuestion(){
  if(app.unitId==='review'){
    const item = app.reviewQueue[app.order[app.qIndex]];
    return { q:item.q, key:qKey(item.chapterId, item.unitId, item.qIndex) };
  }
  const ch = chapterById(app.chapterId);
  const u = unitById(ch, app.unitId);
  const realIdx = app.order[app.qIndex];
  return { q:u.questions[realIdx], key:qKey(ch.id, u.id, realIdx) };
}

function renderQuiz(root){
  const total = app.order.length;
  const {q} = currentQuestion();
  const pct = Math.round((app.qIndex/total)*100);
  if(!app._optOrder || app._optOrderFor !== app.qIndex){ app._optOrder = shuffle(q.options.map((_,i)=>i)); app._optOrderFor = app.qIndex; }
  const opts = app._optOrder.map(i=>q.options[i]);
  const correctDisplay = app._optOrder.indexOf(q.answer);

  let html = topbar(true, app.unitId==='review' ? 'goDashboard' : 'goUnitIntro');
  html += `<div class="screen">
    <div class="progress-track"><div class="progress-fill" style="width:${pct}%"></div></div>
    <div class="q-count">${app.unitId==='review' ? 'REVIEW' : 'QUESTION'} ${app.qIndex+1} OF ${total}</div>
    <div class="q-prompt">${q.prompt}</div>`;
  opts.forEach((opt, i)=>{
    let cls = 'option'; let disabled = '';
    if(app.answered !== null){
      disabled = 'disabled';
      if(i === correctDisplay) cls += ' correct';
      else if(i === app.answered) cls += ' wrong';
      else cls += ' dim';
    }
    html += `<button class="${cls}" ${disabled} onclick="selectOption(${i}, ${correctDisplay})">${opt}</button>`;
  });
  if(app.answered !== null){
    const ok = app.answered === correctDisplay;
    html += `<div class="feedback ${ok?'ok':'no'}"><span class="ic">${ok?'✓':'✕'}</span><span>${q.explain}</span></div>`;
    html += `<button class="primary-btn" onclick="nextQuestion()">${app.qIndex+1===total ? 'See results' : 'Continue'}</button>`;
  }
  html += `</div>`;
  root.innerHTML = html;
}

function selectOption(i, correctDisplay){
  if(app.answered !== null) return;
  app.answered = i;
  const {key} = currentQuestion();
  const ok = i === correctDisplay;
  if(ok) app.correctCount++;
  const gained = recordAnswer(key, ok);
  app.xpGained += gained;
  saveState();
  render();
  showXpPopup(gained);
}
function showXpPopup(n){
  const el = document.createElement('div'); el.className = 'xp-pop'; el.textContent = '+' + n + ' XP';
  document.body.appendChild(el); setTimeout(()=>el.remove(), 1100);
}
function nextQuestion(){
  if(app.qIndex+1 < app.order.length){ app.qIndex++; app.answered = null; render(); }
  else{ finishQuiz(); }
}
function finishQuiz(){
  const total = app.order.length;
  const pct = Math.round((app.correctCount/total)*100);
  if(app.unitId !== 'review'){
    const stars = starsFor(pct);
    const key = unitKey(app.chapterId, app.unitId);
    const prevStars = state.unitStars[key];
    state.unitStars[key] = (prevStars===undefined) ? stars : Math.max(prevStars, stars);
    saveState();
  }
  app._resultsPct = pct;
  app.screen = 'results';
  render();
}

function renderResults(root){
  const total = app.order.length;
  const pct = app._resultsPct;
  const stars = starsFor(pct);
  let html = topbar(true, app.unitId==='review' ? 'goDashboard' : 'goChapterMap');
  html += `<div class="results-wrap">
    <div class="results-ring" style="--pct:${pct}"><div class="inner"><div class="pctnum mono">${pct}%</div><div class="pctlbl">ACCURACY</div></div></div>
    <div class="results-stars">${'★'.repeat(stars)}${'☆'.repeat(3-stars)}</div>
    <h2>${app.unitId==='review' ? 'Review complete' : 'Unit complete'}</h2>
    <div class="results-row">
      <div class="rstat"><div class="v">${app.correctCount}/${total}</div><div class="l">Correct</div></div>
      <div class="rstat"><div class="v">+${app.xpGained}</div><div class="l">XP earned</div></div>
      <div class="rstat"><div class="v">${state.streak}</div><div class="l">Day streak</div></div>
    </div>`;
  if(allMistakeCount() > 0){
    html += `<button class="primary-btn" onclick="startReview()">Review ${allMistakeCount()} mistake${allMistakeCount()>1?'s':''}</button>`;
  }
  html += `<button class="secondary-btn" onclick="${app.unitId==='review' ? 'goDashboard' : 'goChapterMap'}()">Back</button></div>`;
  root.innerHTML = html;
}

function renderReviewEmpty(root){
  let html = topbar(true, 'goDashboard');
  html += `<div class="results-wrap">
    <div style="font-size:50px; margin-bottom:14px;">✨</div>
    <h2>No mistakes to review</h2>
    <div class="empty-note" style="padding:0 0 20px;">Every question you've missed so far has been cleared. Keep going with new units.</div>
    <button class="primary-btn" onclick="goDashboard()">Back to dashboard</button>
  </div>`;
  root.innerHTML = html;
}

function goDashboard(){ app.screen='dashboard'; app.chapterId=null; app.unitId=null; app._optOrder=null; render(); }
function toggleTestMode(){ state.testMode = !state.testMode; saveState(); render(); }
function goChapterList(){ app.screen='chapterList'; app._optOrder=null; render(); }
function openChapter(id){ app.chapterId=id; app.screen='chapterMap'; render(); }
function goChapterMap(){ app.screen='chapterMap'; app._optOrder=null; render(); }
function openUnit(id){ app.unitId=id; app.screen='unit'; render(); }
function goUnitIntro(){ app.screen='unit'; render(); }

loadState();
</script>
</body>
</html>
