/* ============================= STATE ============================= */
const STORE_KEY = 'derm-app-state';
let state = null;
let app = { screen:'loading', chapterId:null, unitId:null, qIndex:0, order:[], answered:null, correctCount:0, xpGained:0, reviewQueue:[] };

function defaultState(){ return { xp:0, streak:0, lastActive:null, unitStars:{}, boxes:{}, mistakes:[], testMode:false }; }

function hasClaudeStorage(){ return typeof window.storage !== 'undefined' && window.storage && typeof window.storage.get === 'function'; }

async function loadState(){
  try{
    if(hasClaudeStorage()){
      const res = await window.storage.get(STORE_KEY, false);
      if(res && res.value){ state = JSON.parse(res.value); }
      else { state = defaultState(); }
    } else {
      const raw = localStorage.getItem(STORE_KEY);
      state = raw ? JSON.parse(raw) : defaultState();
    }
  }catch(e){ state = defaultState(); }
  touchStreak();
  await saveState();
  app.screen = 'dashboard';
  render();
}
async function saveState(){
  try{
    if(hasClaudeStorage()){
      await window.storage.set(STORE_KEY, JSON.stringify(state), false);
    } else {
      localStorage.setItem(STORE_KEY, JSON.stringify(state));
    }
  }catch(e){}
}
function touchStreak(){
  const today = new Date().toDateString();
  if(state.lastActive !== today){
    const yesterday = new Date(Date.now() - 86400000).toDateString();
    state.streak = (state.lastActive === yesterday) ? state.streak + 1 : 1;
    state.lastActive = today;
  }
}

/* ============================= HELPERS ============================= */
function chapterById(id){ return CHAPTERS.find(c=>c.id===id); }
function unitKey(chId, unitId){ return chId+'::'+unitId; }
function qKey(chId, unitId, idx){ return chId+'::'+unitId+'::q'+idx; }
function shuffle(arr){ const a=arr.slice(); for(let i=a.length-1;i>0;i--){ const j=Math.floor(Math.random()*(i+1)); [a[i],a[j]]=[a[j],a[i]]; } return a; }
function unitById(ch, id){ return ch.units.find(u=>u.id===id); }
function isUnitUnlocked(ch, idx){ if(state.testMode) return true; if(idx===0) return true; const prev=ch.units[idx-1]; return state.unitStars[unitKey(ch.id, prev.id)] !== undefined; }
function allMistakeCount(){ return state.mistakes.length; }
function builtChapterCount(){ return CHAPTERS.filter(c=>c.built).length; }

function recordAnswer(key, correct){
  const box = (state.boxes[key] && state.boxes[key].box) || 0;
  if(correct){
    state.boxes[key] = { box: Math.min(box+1, 4) };
    state.mistakes = state.mistakes.filter(id => id !== key);
    state.xp += 10; return 10;
  }else{
    state.boxes[key] = { box: 0 };
    if(!state.mistakes.includes(key)) state.mistakes.push(key);
    state.xp += 2; return 2;
  }
}
function starsFor(pct){ if(pct>=90) return 3; if(pct>=70) return 2; if(pct>=50) return 1; return 0; }

