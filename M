function renderChapterMap(root){
  const ch = chapterById(app.chapterId);
  const zones = CH_ZONES[ch.id] || {};
  let html = topbar(true, 'goChapterList');
  html += `<div class="chapter-label">Chapter ${ch.num}</div><div class="chapter-title">${ch.title}</div>`;

  if(!ch.units){
    html += `<div class="guide-card" style="margin-top:22px">
      <div class="guide-title">Source pages not included</div>
      <div class="guide-text">The uploaded document ends at page 150, while this chapter is listed in the contents but its teaching pages are not present in this file. No questions have been generated here so that the project does not add material from outside the source.</div>
    </div>`;
    html += `<div style="height:70px;"></div>`;
    root.innerHTML = html;
    return;
  }

  let lastZone = null;
  ch.units.forEach((u, idx)=>{
    const zm = zones[u.zone] || {label:'📖 Line-by-Line Pass', hue:'gold'};
    if(u.zone !== lastZone){
      html += `<div class="zone zone-${zm.hue}"><div class="zone-heading"><span class="ln"></span>${zm.label}<span class="ln"></span></div>`;
      lastZone = u.zone;
    } else {
      html += `<div class="zone zone-${zm.hue}">`;
    }
    const unlocked = isUnitUnlocked(ch, idx);
    const stars = state.unitStars[unitKey(ch.id,u.id)];
    const done = stars !== undefined;
    let nodeClass = 'node ' + (done ? 'done' : unlocked ? ('hue-'+zm.hue+' unlocked') : 'locked');
    const inner = done ? '✓' : unlocked ? u.num : '<span class="lock-ic">🔒</span>';
    const onclick = unlocked ? `onclick="openUnit('${u.id}')"` : '';
    html += `<div class="node-wrap">
        <button class="${nodeClass}" ${onclick}>${inner}</button>
        <div class="node-label">${u.title}</div>
        <div class="node-stars">${done ? '★'.repeat(stars) + '☆'.repeat(3-stars) : ''}</div>
      </div></div>`;
    if(idx < ch.units.length-1) html += `<div class="zone-connector"></div>`;
  });
  html += `<div style="height:70px;"></div>`;
  if(allMistakeCount() > 0){
    html += `<button class="review-fab" onclick="startReview()">↻ Review mistakes <span class="badge">${allMistakeCount()}</span></button>`;
  }
  root.innerHTML = html;
}

